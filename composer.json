{
  "name": "otium/yachtfolio-sync",
  "description": "One-way Yachtfolio -> WordPress yacht catalogue sync for Otium Yachts.",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "woocommerce/action-scheduler": "^3.9"
  },
  "autoload": {
    "psr-4": { "Otium\\Yachtfolio\\": "src/" }
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": { "composer/installers": true }
  },
  "minimum-stability": "stable"
}
