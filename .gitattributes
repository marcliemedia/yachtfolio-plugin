# Normalise to LF in the repository. Without this, a commit made on Windows
# rewrites every line of every file and the next diff is unreadable — the plugin
# is edited on Windows locally and deployed to Linux.
* text=auto eol=lf

*.php   text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.lock  text eol=lf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary

# Keep archives lean: nothing below ships to a site.
/.gitattributes export-ignore
/.gitignore     export-ignore
